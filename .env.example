# Server only; loading this file is the host application's responsibility.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_REVIEW_MODEL=gemini-3.5-flash
# Used automatically when the model above is overloaded or times out.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
BILL_DB_PATH=data/bills.sqlite3
# Phone provider for dispute calls: bland (default for the demo) or vapi.
CALL_PROVIDER=bland
# Bland: calls go out from Bland's own number pool, so only the API key is required.
BLAND_API_KEY=
# Optional. turbo is fastest but can't navigate phone menus; use base for real hospital lines.
BLAND_MODEL=turbo
BLAND_VOICE_ID=

# Vapi (only when CALL_PROVIDER=vapi): the saved assistant and the ID of the Telnyx number imported INTO VAPI.
# VAPI_API_KEY is Vapi's private key, not a Telnyx key or Gemini key.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
# Optional inline assistant fallback when VAPI_ASSISTANT_ID is absent:
VAPI_VOICE_ID=
VAPI_GEMINI_MODEL=gemini-3.5-flash
# Optional demo token; when set, the app must send the same EXPO_PUBLIC_DEMO_TOKEN.
GEM_DEMO_TOKEN=
# TEST MODE: while set, every dispute call goes to this phone (E.164) instead of the
# hospital. Leave it set until you have heard a test call; unset it to call hospitals.
GEM_DEMO_PHONE_NUMBER=
# Charges above this multiple of the Medicare rate are disputed as overcharges.
GEM_OVERCHARGE_MULTIPLE=2
# CORS origins; defaults to * for the demo.
ALLOWED_ORIGINS=

# Expo app (bundled into the app). One server serves /ocr and /cases.
# Use this computer's LAN IP so a phone can reach it.
EXPO_PUBLIC_API_URL=http://192.168.1.25:8000
EXPO_PUBLIC_DEMO_TOKEN=
